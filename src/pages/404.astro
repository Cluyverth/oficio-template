---
import Base from "../layouts/Base.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
---

<Base title="Página não encontrada" description="A página que você procura não existe. Volte para o início ou fale conosco pelo WhatsApp.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="font-display text-7xl font-bold text-brand">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-stone-900">Página não encontrada</h1>
    <p class="mt-3 text-stone-600">
      O endereço que você acessou não existe ou foi movido. Que tal voltar para o início ou
      chamar a gente no WhatsApp?
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
      >
        Voltar para o início
      </a>
      <WhatsAppButton label="Falar no WhatsApp" />
    </div>
  </section>
</Base>
