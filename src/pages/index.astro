---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Servicos from "../components/sections/Servicos.astro";
import Avaliacoes from "../components/sections/Avaliacoes.astro";
import Sobre from "../components/sections/Sobre.astro";
import Faq from "../components/sections/Faq.astro";
import CtaWhatsApp from "../components/sections/CtaWhatsApp.astro";

const reviews = (await getCollection("reviews")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const avg = reviews.reduce((sum, r) => sum + r.data.stars, 0) / reviews.length;

// A ordem das seções abaixo É a ordem do site.
// Para o próximo cliente: reordene, remova ou acrescente seções aqui.
---

<Base>
  <Hero avg={avg} count={reviews.length} />
  <Servicos />
  <Avaliacoes reviews={reviews} avg={avg} />
  <Sobre />
  <Faq />
  <CtaWhatsApp />
</Base>
