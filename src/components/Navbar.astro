---
import { site } from "../config/site";
import { waLink } from "../lib/whatsapp";
import Icon from "./ui/Icon.astro";
import WhatsAppButton from "./ui/WhatsAppButton.astro";

const links = [
  { href: "/#servicos", label: "Serviços" },
  { href: "/projetos", label: "Projetos" },
  { href: "/#avaliacoes", label: "Avaliações" },
  { href: "/#sobre", label: "Sobre" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Principal">
    <!-- Esquerda: hamburguer no mobile, logo no desktop -->
    <div class="flex items-center gap-3">
      <details class="group relative md:hidden">
        <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-stone-700 transition hover:bg-stone-100">
          <Icon name="menu" class="h-6 w-6" />
        </summary>
        <div class="absolute left-0 top-12 w-60 rounded-xl border border-stone-200 bg-white p-2 shadow-xl">
          {links.map((l) => (
            <a
              href={l.href}
              class="block rounded-lg px-3 py-2.5 text-sm font-medium text-stone-700 transition hover:bg-stone-50"
            >
              {l.label}
            </a>
          ))}
        </div>
      </details>

      <a href="/#topo" class="hidden items-center gap-2.5 font-display text-lg font-bold text-stone-900 md:flex">
        <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="var(--brand-deep)" />
          <g stroke="#E8D9C0" stroke-width="2.4" stroke-linecap="round" fill="none">
            <path d="M7 10h18" />
            <path d="M11 10v7" />
            <path d="M21 10v7" />
            <path d="M7 17h18" />
          </g>
        </svg>
        <span>{site.name}</span>
      </a>
    </div>

    <!-- Direita: links + Instagram + WhatsApp, sempre fora do menu -->
    <div class="flex items-center gap-2.5 md:gap-7">
      <div class="hidden items-center gap-7 md:flex">
        {links.map((l) => (
          <a href={l.href} class="text-sm font-medium text-stone-600 transition hover:text-stone-900">
            {l.label}
          </a>
        ))}
      </div>

      {site.instagram && (
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          class="flex h-10 w-10 items-center justify-center transition hover:scale-105"
        >
          <Icon name="instagram" class="h-6 w-6" />
        </a>
      )}

      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-wa text-white shadow-lg shadow-wa/25 transition hover:bg-wa-dark md:hidden"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
      </a>
      <div class="hidden md:block">
        <WhatsAppButton label="Orçamento" />
      </div>
    </div>
  </nav>
</header>
