---
import { site } from "../../config/site";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="faq" class="bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Dúvidas frequentes"
      title="Perguntas que sempre recebemos"
      description="Se a sua dúvida não estiver aqui, é só chamar no WhatsApp."
    />

    <div class="mt-12 space-y-4">
      {site.faq.map((f) => (
        <details class="group rounded-2xl border border-stone-200 bg-white p-5 transition open:border-brand/40 open:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-stone-900">
            {f.q}
            <span aria-hidden="true" class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand/10 text-lg leading-none text-brand transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
