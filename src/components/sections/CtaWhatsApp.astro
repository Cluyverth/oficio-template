---
import { site } from "../../config/site";
import WhatsAppButton from "../ui/WhatsAppButton.astro";
---

<section class="relative overflow-hidden bg-brand-deep py-20 text-center sm:py-24">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-brand/30 blur-3xl" />
  </div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
      Vamos tirar seu projeto do papel?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-stone-300">
      Mande uma mensagem no WhatsApp com a sua ideia. Respondemos rápido, com orçamento sem compromisso.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <WhatsAppButton size="lg" label="Pedir orçamento agora" />
      <a
        href={`tel:+${site.phone}`}
        class="text-sm font-semibold text-stone-300 underline-offset-4 transition hover:text-white hover:underline"
      >
        ou ligue: {site.phoneDisplay}
      </a>
    </div>
    <p class="mt-6 text-xs text-stone-400">{site.hours}</p>
  </div>
</section>
