---
import Icon from "./Icon.astro";
import { waLink } from "../../lib/whatsapp";

interface Props {
  label?: string;
  /** Mensagem pré-preenchida (padrão: site.whatsappMessage) */
  message?: string;
  size?: "md" | "lg";
  class?: string;
}

const {
  label = "Pedir orçamento",
  message,
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  md: "px-5 py-2.5 text-sm gap-2",
  lg: "px-7 py-3.5 text-base gap-2.5",
};
---

<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  class={`inline-flex items-center justify-center rounded-full bg-wa font-semibold text-white shadow-lg shadow-wa/25 transition hover:bg-wa-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa ${sizes[size]} ${className}`}
>
  <Icon name="whatsapp" class="h-5 w-5 shrink-0" />
  {label}
</a>
