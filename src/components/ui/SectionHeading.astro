---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "center" | "left";
}

const { eyebrow, title, description, align = "center" } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-widest text-brand">{eyebrow}</p>
  )}
  <h2 class="mt-2 font-display text-3xl font-bold text-stone-900 sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg text-stone-600">{description}</p>}
</div>
